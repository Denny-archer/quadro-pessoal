# Allowlist: somente código de execução e dependências de produção.
**
!Dockerfile
!Dockerfile.testes
!.dockerignore
!backend/
backend/**
!backend/requirements.txt
!backend/requirements-dev.txt
!backend/app/
!backend/app/**
!frontend/
frontend/**
!frontend/*.html
!frontend/scripts/
!frontend/scripts/**
!frontend/styles/
!frontend/styles/**
!frontend/assets/
!frontend/assets/**
!db/
db/**
!db/schema.sql
!db/migrations/
!db/migrations/*.py
!frontend/demandas/
!frontend/demandas/**
**/__pycache__/
**/*.py[cod]
**/.env
**/.env.*
**/node_modules/

# Allowlist: somente código de execução e dependências de produção.
**
!Dockerfile
!.dockerignore
!backend/
backend/**
!backend/requirements.txt
!backend/app/
!backend/app/**
!frontend/
frontend/**
!frontend/*.html
!frontend/scripts/
!frontend/scripts/**
!frontend/styles/
!frontend/styles/**
!frontend/assets/
!frontend/assets/**
!db/
db/**
!db/schema.sql
**/__pycache__/
**/*.py[cod]
**/.env
**/.env.*
**/node_modules/

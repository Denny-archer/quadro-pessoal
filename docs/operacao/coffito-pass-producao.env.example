# Copie como .env do Coffito Pass no servidor, fora do Git, com chmod 600.
# Use quadro no bootstrap; após restaurar no banco vazio, troque para quadro_prod.
POSTGRES_DB=quadro
POSTGRES_USER=quadro
# Gere valores distintos, por exemplo com openssl rand -hex 32.
POSTGRES_PASSWORD=
JWT_SECRET=
COOKIE_SEGURO=true
ACESSO_SOMENTE_ADMIN=true
API_DOCS=false
WEB_CONCURRENCY=2
DB_POOL_MAX=10
BACKUP_RETENCAO_DIAS=30
# Exemplo para proxy no host. Confirme porta livre e origem real do proxy.
PORTA=127.0.0.1:18080
FORWARDED_ALLOW_IPS=127.0.0.1

# Copie para .env e preencha. NUNCA versione o .env.

# Banco
POSTGRES_DB=quadro
POSTGRES_USER=quadro
POSTGRES_PASSWORD=troque-por-uma-senha-longa

# Assinatura das sessões — gere com: openssl rand -hex 32
JWT_SECRET=

# true em produção (HTTPS). Use false só para testar em http://localhost
COOKIE_SEGURO=true
SESSAO_HORAS=10
TAMANHO_MAX_UPLOAD_MB=10
WEB_CONCURRENCY=2
DB_POOL_MAX=10
API_DOCS=false
# Informe somente IPs/redes dos proxies da TI que podem enviar X-Forwarded-*.
FORWARDED_ALLOW_IPS=127.0.0.1

# Onde a aplicação escuta no host. Padrão só local (o proxy HTTPS encaminha para ela).
PORTA=127.0.0.1:8000

BACKUP_RETENCAO_DIAS=30
